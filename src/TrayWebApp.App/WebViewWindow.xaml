<Window x:Class="TrayWebApp.App.WebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TrayWebApp"
        Width="430" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/icon.ico">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddressTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="2,3,0,2"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="MaxWidth" Value="150"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5,5,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition x:Name="AddressBarRow" Height="36"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navigation buttons -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="&lt;" Style="{StaticResource ToolbarButton}"
                                Click="BackButton_Click" ToolTip="뒤로"/>
                        <Button Content="&gt;" Style="{StaticResource ToolbarButton}"
                                Click="ForwardButton_Click" ToolTip="앞으로"/>
                        <Button Style="{StaticResource ToolbarButton}"
                                Click="RefreshButton_Click" ToolTip="새로고침">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="18" Height="18">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M14,6 C13,3.8 10.7,2.4 8.2,2.7 C5.2,3 3,5.5 3,8.5 C3,12.1 5.9,15 9.5,15 C12,15 14.1,13.6 15.2,11.5"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M14,2.7 L14,6.2 L10.5,6.2"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}"
                                Click="HomeButton_Click" ToolTip="홈">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="18" Height="18">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M3,8.4 L9,3 L15,8.4"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M5,7.6 L5,15 L13,15 L13,7.6"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <!-- Opacity control -->
                    <Grid Grid.Row="0" Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="투명도" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Grid.Column="1" x:Name="OpacitySlider"
                                Minimum="0.2" Maximum="1.0" Value="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ToolTip="창과 웹페이지 투명도"/>
                        <TextBlock Grid.Column="2" x:Name="OpacityValueText" Text="100%"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Window controls -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button x:Name="PinButton" Style="{StaticResource ToolbarButton}"
                                Click="PinButton_Click" ToolTip="항상 위">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="18" Height="18">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M10.5,2.8 L15.2,7.5"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M12.6,4.9 L7.4,10.1"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M6.3,9 L9,11.7 L4,16"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M5.4,3.2 L13.8,11.6"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}"
                                Click="OpenExternalButton_Click" ToolTip="기본 브라우저로 열기">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="18" Height="18">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M4,7 L4,14 L11,14"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M8,4 L14,4 L14,10"/>
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M14,4 L8,10"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Content="-" Style="{StaticResource ToolbarButton}"
                                Click="MinimizeButton_Click" ToolTip="숨기기"/>
                        <Button Content="X" Style="{StaticResource ToolbarButton}"
                                Click="CloseButton_Click" ToolTip="닫기"
                                Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>

                    <!-- Address -->
                    <TextBox Grid.Row="1" Grid.ColumnSpan="3" x:Name="AddressInput"
                             Style="{StaticResource AddressTextBox}"
                             Margin="8,0,8,6" Height="28"
                             KeyDown="AddressInput_KeyDown"
                             ToolTip="주소를 입력하고 Enter를 누르세요"/>
                </Grid>
            </Border>

            <!-- WebView2 -->
            <ContentControl Grid.Row="1" x:Name="WebViewHost"/>

            <!-- Tabs -->
            <DockPanel Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}" LastChildFill="True" Margin="0">
                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource ToolbarButton}"
                        Click="NewTabButton_Click" ToolTip="새 탭" FontSize="14"
                        MinWidth="30" Margin="4,3,6,3"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="6,0,0,0">
                    <StackPanel x:Name="TabsHost" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="8,4" CornerRadius="0,0,12,12">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="以鍮꾨맖" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="ZoomText" Text="100%" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

