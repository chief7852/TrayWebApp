<Window x:Class="TrayWebApp.App.WebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TrayWebApp"
        Width="430" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/icon.ico">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0A0B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D52"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4D4D66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddressTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="BorderBrush" Value="#404060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#1E1E2E" BorderBrush="#404060" BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#2D2D3F" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition x:Name="AddressBarRow" Height="36"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navigation buttons -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="&lt;" Style="{StaticResource ToolbarButton}"
                                Click="BackButton_Click" ToolTip="뒤로"/>
                        <Button Content="&gt;" Style="{StaticResource ToolbarButton}"
                                Click="ForwardButton_Click" ToolTip="앞으로"/>
                        <Button Content="R" Style="{StaticResource ToolbarButton}"
                                Click="RefreshButton_Click" ToolTip="새로고침" FontSize="12"/>
                        <Button Content="H" Style="{StaticResource ToolbarButton}"
                                Click="HomeButton_Click" ToolTip="홈" FontSize="12"/>
                    </StackPanel>

                    <!-- Opacity control -->
                    <Grid Grid.Row="0" Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="투명도" Foreground="#A0A0B8"
                                   FontSize="11" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Grid.Column="1" x:Name="OpacitySlider"
                                Minimum="0.2" Maximum="1.0" Value="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ToolTip="창과 웹페이지 투명도"/>
                        <TextBlock Grid.Column="2" x:Name="OpacityValueText" Text="100%"
                                   Foreground="#A0A0B8" FontSize="11"
                                   FontFamily="Segoe UI" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Window controls -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                        <Button x:Name="PinButton" Content="고정" Style="{StaticResource ToolbarButton}"
                                Click="PinButton_Click" ToolTip="항상 위 전환" FontSize="12"/>
                        <Button Content="열기" Style="{StaticResource ToolbarButton}"
                                Click="OpenExternalButton_Click" ToolTip="기본 브라우저로 열기" FontSize="12"/>
                        <Button Content="-" Style="{StaticResource ToolbarButton}"
                                Click="MinimizeButton_Click" ToolTip="숨기기"/>
                        <Button Content="X" Style="{StaticResource ToolbarButton}"
                                Click="CloseButton_Click" ToolTip="닫기"
                                Foreground="#FF6464"/>
                    </StackPanel>

                    <!-- Address -->
                    <TextBox Grid.Row="1" Grid.ColumnSpan="3" x:Name="AddressInput"
                             Style="{StaticResource AddressTextBox}"
                             Margin="8,0,8,6" Height="28"
                             KeyDown="AddressInput_KeyDown"
                             ToolTip="주소를 입력하고 Enter를 누르세요"/>
                </Grid>
            </Border>

            <!-- WebView2 -->
            <wv2:WebView2 Grid.Row="1" x:Name="WebView"
                          DefaultBackgroundColor="Transparent"/>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#2D2D3F" Padding="8,4" CornerRadius="0,0,12,12">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="준비됨" Foreground="#707088"
                               FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="ZoomText" Text="100%" Foreground="#707088"
                                   FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
