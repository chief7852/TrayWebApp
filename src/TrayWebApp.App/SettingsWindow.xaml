<Window x:Class="TrayWebApp.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayWebApp - 설정"
        Width="500" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/icon.ico">

    <Window.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="설정" Foreground="{DynamicResource AccentBrush}"
                               FontSize="14" FontFamily="Segoe UI" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Content="X" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Style="{StaticResource ActionButton}"
                            Foreground="{DynamicResource DangerBrush}" Padding="8,4"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
                <StackPanel>
                    <TextBlock Text="일반" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="테마:  " Style="{StaticResource SettingLabel}"/>
                        <ComboBox Grid.Column="1" x:Name="ThemeModeInput"
                                  SelectionChanged="ThemeModeInput_SelectionChanged"
                                  VerticalContentAlignment="Center"
                                  FontFamily="Segoe UI" FontSize="13"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}">
                            <ComboBoxItem Content="다크 모드" Tag="Dark"/>
                            <ComboBoxItem Content="라이트 모드" Tag="Light"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="RunAtStartupCheck" Content="  Windows 시작 시 실행"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="RunAtStartupCheck_Changed" Unchecked="RunAtStartupCheck_Changed"/>
                    <CheckBox x:Name="AlwaysOnTopCheck" Content="  기본값: 항상 위"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="AlwaysOnTopCheck_Changed" Unchecked="AlwaysOnTopCheck_Changed"/>
                    <CheckBox x:Name="HideOnCloseCheck" Content="  닫을 때 종료하지 않고 트레이로 숨기기"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="HideOnCloseCheck_Changed" Unchecked="HideOnCloseCheck_Changed"/>
                    <CheckBox x:Name="HideOnDeactivateCheck" Content="  바깥을 클릭하면 창 숨기기"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="HideOnDeactivateCheck_Changed" Unchecked="HideOnDeactivateCheck_Changed"/>
                    <CheckBox x:Name="ShowAddressBarCheck" Content="  주소창 표시"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="ShowAddressBarCheck_Changed" Unchecked="ShowAddressBarCheck_Changed"/>
                    <CheckBox x:Name="OpenPopupsExternallyCheck" Content="  팝업은 기본 브라우저로 열기"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="OpenPopupsExternallyCheck_Changed" Unchecked="OpenPopupsExternallyCheck_Changed"/>
                    <CheckBox x:Name="AutoAllowNotificationsCheck" Content="  알림 권한 자동 허용"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="AutoAllowNotificationsCheck_Changed" Unchecked="AutoAllowNotificationsCheck_Changed"/>

                    <TextBlock Text="창" Style="{StaticResource SectionHeader}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="기본 크기:  " Style="{StaticResource SettingLabel}"/>
                        <TextBox Grid.Column="1" x:Name="DefaultWidthInput" Style="{StaticResource InputBox}"/>
                        <TextBlock Grid.Column="2" Text="  x  " Style="{StaticResource SettingLabel}"/>
                        <TextBox Grid.Column="3" x:Name="DefaultHeightInput" Style="{StaticResource InputBox}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="투명도:  " Style="{StaticResource SettingLabel}"/>
                        <Slider x:Name="OpacitySlider" Width="200" Minimum="0.2" Maximum="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="OpacitySlider_Changed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OpacityLabel" Text="100%" Style="{StaticResource SettingLabel}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="다운로드" Style="{StaticResource SectionHeader}"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="폴더:  " Style="{StaticResource SettingLabel}"/>
                        <TextBox Grid.Column="1" x:Name="DownloadFolderInput"
                                 Style="{StaticResource InputBox}" IsReadOnly="True"/>
                        <Button Grid.Column="2" Content="찾기" Style="{StaticResource ActionButton}"
                                Margin="8,0,0,0" Click="BrowseDownloadFolder_Click"/>
                    </Grid>
                    <TextBlock Text="WebView에서 내려받은 파일이 저장되는 위치입니다."
                               Style="{StaticResource SettingDesc}"/>

                    <TextBlock Text="키보드 단축키" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,4">
                        <Run Text="Ctrl+Alt+Space" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"/>
                        <Run Text="  창 열기/숨기기"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,4">
                        <Run Text="Ctrl+Alt+1~9" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"/>
                        <Run Text="  순서대로 앱 열기"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,4">
                        <Run Text="Ctrl+K" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"/>
                        <Run Text="  앱 빠른 전환"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,4">
                        <Run Text="Ctrl+T / Ctrl+W" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"/>
                        <Run Text="  탭 열기 / 닫기"/>
                    </TextBlock>

                    <TextBlock Text="데이터" Style="{StaticResource SectionHeader}"/>
                    <Button Content="WebView 캐시 삭제" Style="{StaticResource DangerButton}"
                            Click="ClearCache_Click"/>
                    <TextBlock Text="브라우저 캐시만 지우고 쿠키와 로그인 세션은 유지합니다."
                               Style="{StaticResource SettingDesc}"/>

                    <Button Content="모든 설정 초기화" Style="{StaticResource DangerButton}"
                            Click="ResetSettings_Click" Margin="0,8,0,0"/>
                    <TextBlock Text="앱 목록은 유지하고 설정값만 기본값으로 되돌립니다."
                               Style="{StaticResource SettingDesc}"/>

                    <Button Content="데이터 폴더 열기" Style="{StaticResource ActionButton}"
                            Click="OpenDataFolder_Click" Margin="0,8,0,0"/>

                    <TextBlock Text="정보" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontFamily="Segoe UI">
                        <Run Text="TrayWebApp v1.0.3" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <LineBreak/>
                        <Run Text="A tray-based mini browser for Windows"/>
                        <LineBreak/>
                        <Run Text="Powered by WebView2 + WPF"/>
                    </TextBlock>

                    <StackPanel Height="16"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
