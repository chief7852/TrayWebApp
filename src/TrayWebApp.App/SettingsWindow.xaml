<Window x:Class="TrayWebApp.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrayWebApp - 설정"
        Width="480" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/icon.ico">

    <Window.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#707088"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00D2FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D3F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#404060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="#00D2FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3D3D52"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4D4D66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D3F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#4A1E1E"/>
            <Setter Property="Foreground" Value="#FF6464"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6A2E2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A1515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#1E1E2E" BorderBrush="#404060" BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#2D2D3F" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="설정" Foreground="#00D2FF"
                               FontSize="14" FontFamily="Segoe UI" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Content="X" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Style="{StaticResource ActionButton}"
                            Foreground="#FF6464" Padding="8,4"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,16">
                <StackPanel>

                    <!-- General -->
                    <TextBlock Text="일반" Style="{StaticResource SectionHeader}"/>

                    <CheckBox x:Name="RunAtStartupCheck" Content="  Windows 시작 시 실행"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="RunAtStartupCheck_Changed" Unchecked="RunAtStartupCheck_Changed"/>

                    <CheckBox x:Name="AlwaysOnTopCheck" Content="  기본값: 항상 위"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="AlwaysOnTopCheck_Changed" Unchecked="AlwaysOnTopCheck_Changed"/>

                    <CheckBox x:Name="HideOnCloseCheck" Content="  닫을 때 종료하지 않고 트레이로 숨김"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="HideOnCloseCheck_Changed" Unchecked="HideOnCloseCheck_Changed"/>

                    <CheckBox x:Name="HideOnDeactivateCheck" Content="  바깥을 클릭하면 창 숨김"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="HideOnDeactivateCheck_Changed" Unchecked="HideOnDeactivateCheck_Changed"/>

                    <CheckBox x:Name="ShowAddressBarCheck" Content="  주소창 표시"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="ShowAddressBarCheck_Changed" Unchecked="ShowAddressBarCheck_Changed"/>

                    <CheckBox x:Name="OpenPopupsExternallyCheck" Content="  팝업은 기본 브라우저로 열기"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="OpenPopupsExternallyCheck_Changed" Unchecked="OpenPopupsExternallyCheck_Changed"/>

                    <CheckBox x:Name="AutoAllowNotificationsCheck" Content="  알림 권한 자동 허용"
                              Style="{StaticResource ToggleSwitch}"
                              Checked="AutoAllowNotificationsCheck_Changed" Unchecked="AutoAllowNotificationsCheck_Changed"/>

                    <!-- Window -->
                    <TextBlock Text="창" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="기본 크기:  " Style="{StaticResource SettingLabel}"/>
                        <TextBox Grid.Column="1" x:Name="DefaultWidthInput" Style="{StaticResource DarkTextBox}"/>
                        <TextBlock Grid.Column="2" Text="  x  " Style="{StaticResource SettingLabel}"/>
                        <TextBox Grid.Column="3" x:Name="DefaultHeightInput" Style="{StaticResource DarkTextBox}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="투명도:  " Style="{StaticResource SettingLabel}"/>
                        <Slider x:Name="OpacitySlider" Width="200" Minimum="0.2" Maximum="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="OpacitySlider_Changed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OpacityLabel" Text="100%" Style="{StaticResource SettingLabel}"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Downloads -->
                    <TextBlock Text="다운로드" Style="{StaticResource SectionHeader}"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="폴더:  " Style="{StaticResource SettingLabel}"/>
                        <TextBox Grid.Column="1" x:Name="DownloadFolderInput"
                                 Style="{StaticResource DarkTextBox}" IsReadOnly="True"/>
                        <Button Grid.Column="2" Content="찾기" Style="{StaticResource ActionButton}"
                                Margin="8,0,0,0" Click="BrowseDownloadFolder_Click"/>
                    </Grid>
                    <TextBlock Text="WebView에서 내려받은 파일이 여기에 저장됩니다"
                               Style="{StaticResource SettingDesc}"/>

                    <!-- Shortcuts -->
                    <TextBlock Text="키보드 단축키" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,4">
                        <Run Text="Ctrl+Alt+Space" Foreground="#00D2FF" FontFamily="Consolas"/>
                        <Run Text="  창 열기/숨기기"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,4">
                        <Run Text="Ctrl+Alt+1~9" Foreground="#00D2FF" FontFamily="Consolas"/>
                        <Run Text="    순서대로 웹앱 열기"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,4">
                        <Run Text="ESC" Foreground="#00D2FF" FontFamily="Consolas"/>
                        <Run Text="             창 숨기기"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,4">
                        <Run Text="F5" Foreground="#00D2FF" FontFamily="Consolas"/>
                        <Run Text="              새로고침"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,4">
                        <Run Text="F12" Foreground="#00D2FF" FontFamily="Consolas"/>
                        <Run Text="             개발자 도구"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,0,0,4">
                        <Run Text="Ctrl +/-/0" Foreground="#00D2FF" FontFamily="Consolas"/>
                        <Run Text="      확대/축소/초기화"/>
                    </TextBlock>

                    <!-- Data -->
                    <TextBlock Text="데이터" Style="{StaticResource SectionHeader}"/>

                    <Button Content="WebView 캐시 삭제" Style="{StaticResource DangerButton}"
                            Click="ClearCache_Click"/>
                    <TextBlock Text="브라우징 캐시만 지우고 쿠키와 로그인 세션은 유지합니다"
                               Style="{StaticResource SettingDesc}"/>

                    <Button Content="모든 설정 초기화" Style="{StaticResource DangerButton}"
                            Click="ResetSettings_Click" Margin="0,8,0,0"/>
                    <TextBlock Text="앱 목록은 유지하고 설정만 기본값으로 되돌립니다"
                               Style="{StaticResource SettingDesc}"/>

                    <Button Content="데이터 폴더 열기" Style="{StaticResource ActionButton}"
                            Click="OpenDataFolder_Click" Margin="0,8,0,0"/>

                    <!-- About -->
                    <TextBlock Text="정보" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Foreground="#707088" FontSize="12" FontFamily="Segoe UI">
                        <Run Text="TrayWebApp v1.0" FontWeight="SemiBold" Foreground="#A0A0B8"/>
                        <LineBreak/>
                        <Run Text="A tray-based mini browser for Windows"/>
                        <LineBreak/>
                        <Run Text="Powered by WebView2 + WPF"/>
                    </TextBlock>

                    <StackPanel Height="16"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
