<Application x:Class="TrayWebApp.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Theme brushes are replaced at startup by ThemeManager. -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1A8AE6" />
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#005A9E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00D2FF" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E2E" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#2D2D3F" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#252538" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#3D3D52" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8CA" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#7E7E94" />
        <SolidColorBrush x:Key="BorderBrush" Color="#4C4C68" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF6464" />
        <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#4A1E1E" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#6A2E2E" />
    </Application.Resources>
</Application>
